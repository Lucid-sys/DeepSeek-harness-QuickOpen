<?xml version="1.0" encoding="utf-8"?>
<!--
  清掉继承来的 NuGet 回退包文件夹。

  有些 Windows 机器上,机器级配置
  (%ProgramFiles(x86)%\NuGet\Config\Microsoft.VisualStudio.FallbackLocation.config)
  会声明一个并不存在的回退目录(比如某块没挂载的盘)。这种情况下
  `dotnet restore` / `dotnet build` 会直接以 NU1301 / MSB4018 失败 —— 即使项目
  一个 NuGet 包都不引用。

  这个项目级配置用 <clear /> 去掉那些继承来的回退目录,让构建自足、不依赖机器状态。
  本项目不引用任何 NuGet 包,所以清空后依然能正常还原。
-->
<configuration>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
